FROM php:8.2-fpm-bullseye

ARG APP_ID=1500
RUN groupadd -g "$APP_ID" app \
  && useradd -g "$APP_ID" -u "$APP_ID" -d /var/www -s /bin/bash app

RUN mkdir -p /etc/nginx/html /var/www/public_html /sock /etc/msmtprc \
  && chown -R app:app /etc/nginx /var/www /usr/local/etc/php/conf.d /sock

RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash -

RUN apt-get update && apt-get install -y \
    wget \
    cron \
    default-mysql-client \
    git \
    gnupg \
    gzip \
    libbz2-dev \
    libfreetype6-dev \
    libicu-dev \
    libjpeg62-turbo-dev \
    libmagickwand-dev \
    libmcrypt-dev \
    libonig-dev \
    libpng-dev \
    libsodium-dev \
    libssh2-1-dev \
    libwebp-dev \
    libxslt1-dev \
    libzip-dev \
    libc-client-dev \
    libkrb5-dev \
    lsof \
    mailutils \
    msmtp \
    nodejs \
    procps \
    vim \
    zip \
    sudo \
  && rm -rf /var/lib/apt/lists/*

#RUN curl -L -o /tmp/imagick.tar.gz https://github.com/Imagick/imagick/archive/7088edc353f53c4bc644573a79cdcd67a726ae16.tar.gz \
#    && tar --strip-components=1 -xf /tmp/imagick.tar.gz \
#    && phpize \
#    && ./configure \
#    && make \
#    && make install \
#    && echo "extension=imagick.so" > /usr/local/etc/php/conf.d/ext-imagick.ini \
#    && rm -rf /tmp/*

RUN pecl channel-update pecl.php.net && pecl install \
    redis \
    imagick \
    ssh2-1.3.1 \
    xdebug \
  && pecl clear-cache \
  && rm -rf /tmp/pear

RUN docker-php-ext-configure imap --with-kerberos --with-imap-ssl \
  && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
  && docker-php-ext-install \
    bcmath \
    bz2 \
    calendar \
    exif \
    gd \
    gettext \
    intl \
    imap \
    mbstring \
    mysqli \
    opcache \
    pcntl \
    pdo_mysql \
    soap \
    sockets \
    sodium \
    sysvmsg \
    sysvsem \
    sysvshm \
    xsl \
    zip \
  && docker-php-ext-enable \
    imagick \
    redis \
    ssh2 \
    xdebug

RUN echo "app ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/app

RUN curl -sS https://getcomposer.org/installer | \
  php -- --install-dir=/usr/local/bin --filename=composer

#COPY ./conf/msmtprc /etc/msmtprc
#COPY ./conf/php.ini $PHP_INI_DIR
#COPY ./conf/php-fpm.conf /usr/local/etc/
#COPY ./conf/www.conf /usr/local/etc/php-fpm.d/

#USER root:root
#RUN mkdir -p /var/run && touch /var/run/crond.pid && chmod 777 /var/run/crond.pid
#RUN service cron start

USER app:app
VOLUME /var/www
WORKDIR /var/www/html

# Expose ports
EXPOSE 9081

# Entry point
CMD ["/usr/local/sbin/php-fpm", "-R", "--nodaemonize"]
